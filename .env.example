# API server
NODE_ENV=development
PORT=5000
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:3000

# Set a unique random value for local authentication; never commit real secrets.
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Neon PostgreSQL connection. Copy the connection string from your Neon project.
# Keep the real URL only in server/.env; never commit it.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Cloudinary is the selected file-storage provider. Set credentials when Phase 4 begins.
# CLOUDINARY_URL=cloudinary://key:secret@cloud-name

# Brevo transactional email. Store the real key only in server/.env.
# BREVO_API_KEY=your-brevo-api-key
# EMAIL_FROM=Digital Freight Marketplace <notifications@yourdomain.com>

# General API rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Client
VITE_API_BASE_URL=http://localhost:5000/api/v1
