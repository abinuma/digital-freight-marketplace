generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SHIPPER
  TRANSPORTER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum ShipmentStatus {
  DRAFT
  PUBLISHED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum BidStatus {
  PENDING
  ACCEPTED
  DECLINED
  WITHDRAWN
}

enum JourneyPlanStatus {
  ACTIVE
  FULL
  COMPLETED
  CANCELLED
}

model User {
  id               String     @id @default(uuid()) @db.Uuid
  email            String     @unique(map: "idx_user_email") @db.VarChar(255)
  name             String     @db.VarChar(100)
  phone            String?    @db.VarChar(20)
  role             Role?
  status           UserStatus @default(ACTIVE)
  suspensionReason String?    @db.VarChar(500)
  image            String?    @map("profilePhoto") @db.VarChar(500)
  location         String?    @db.VarChar(255)
  region           String?    @db.VarChar(100)
  zone             String?    @db.VarChar(100)
  city             String?    @db.VarChar(100)
  emailVerified    Boolean    @default(false)
  availableDays      String[]   @default([])
  preferredLoadTypes String[]   @default([])
  lookingForLoads    Boolean    @default(false)
  availabilityUpdatedAt DateTime? @db.Timestamp(3)
  createdAt        DateTime   @default(now()) @db.Timestamp(3)
  updatedAt        DateTime   @updatedAt @db.Timestamp(3)

  vehicle                    Vehicle?
  shipments                  Shipment[]
  bids                       Bid[]
  messages                   Message[]
  conversationsAsShipper     Conversation[]       @relation("ConversationShipper")
  conversationsAsTransporter Conversation[]       @relation("ConversationTransporter")
  reviewsGiven               Review[]             @relation("ReviewReviewer")
  reviewsReceived            Review[]             @relation("ReviewReviewee")
  notifications              Notification[]
  shipmentModerations        ShipmentModeration[] @relation("ShipmentModeratedBy")
  sessions                   Session[]
  accounts                   Account[]
  journeyPlans               JourneyPlan[]

  @@index([role, status], map: "idx_user_role_status")
}

model Vehicle {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @unique @db.Uuid
  type         String   @db.VarChar(50)
  capacityTons Decimal  @db.Decimal(10, 2)
  volumeM3     Decimal? @db.Decimal(10, 2)
  plateNumber  String   @db.VarChar(20)
  photo        String?  @db.VarChar(500)
  createdAt    DateTime @default(now()) @db.Timestamp(3)
  updatedAt    DateTime @updatedAt @db.Timestamp(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Shipment {
  id                  String         @id @default(uuid()) @db.Uuid
  shipperId           String         @db.Uuid
  goodsDescription    String         @db.Text
  goodsType           String         @db.VarChar(50)
  weightKg            Decimal        @db.Decimal(10, 2)
  volumeM3            Decimal?       @db.Decimal(10, 2)
  pickupLocation      String         @db.VarChar(255)
  pickupLat           Decimal?       @db.Decimal(10, 7)
  pickupLng           Decimal?       @db.Decimal(10, 7)
  deliveryLocation    String         @db.VarChar(255)
  deliveryLat         Decimal?       @db.Decimal(10, 7)
  deliveryLng         Decimal?       @db.Decimal(10, 7)
  pickupDate          DateTime       @db.Date
  specialRequirements String?        @db.Text
  status              ShipmentStatus @default(DRAFT)
  removedAt           DateTime?      @db.Timestamp(3)
  createdAt           DateTime       @default(now()) @db.Timestamp(3)
  updatedAt           DateTime       @updatedAt @db.Timestamp(3)

  shipper                 User                    @relation(fields: [shipperId], references: [id], onDelete: Restrict)
  images                  ShipmentImage[]
  bids                    Bid[]
  reviews                 Review[]
  moderationActions       ShipmentModeration[]
  journeyPlanAssignments  JourneyPlanAssignment[]

  @@index([shipperId], map: "idx_shipment_shipper")
  @@index([status], map: "idx_shipment_status")
  @@index([goodsType], map: "idx_shipment_goods_type")
  @@index([pickupDate], map: "idx_shipment_pickup_date")
  @@index([createdAt(sort: Desc)], map: "idx_shipment_created")
}

model ShipmentModeration {
  id         String   @id @default(uuid()) @db.Uuid
  shipmentId String   @db.Uuid
  adminId    String   @db.Uuid
  reason     String   @db.VarChar(500)
  createdAt  DateTime @default(now()) @db.Timestamp(3)

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  admin    User     @relation("ShipmentModeratedBy", fields: [adminId], references: [id], onDelete: Restrict)

  @@index([shipmentId, createdAt(sort: Desc)], map: "idx_shipment_moderation_shipment_created")
  @@index([adminId], map: "idx_shipment_moderation_admin")
}

model ShipmentImage {
  id         String   @id @default(uuid()) @db.Uuid
  shipmentId String   @db.Uuid
  url        String   @db.VarChar(500)
  order      Int      @default(0)
  createdAt  DateTime @default(now()) @db.Timestamp(3)

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
}

model Bid {
  id            String    @id @default(uuid()) @db.Uuid
  shipmentId    String    @db.Uuid
  transporterId String    @db.Uuid
  price         Decimal   @db.Decimal(12, 2)
  pickupDate    DateTime  @db.Timestamp(3)
  message       String?   @db.Text
  status        BidStatus @default(PENDING)
  declineReason String?   @db.Text
  createdAt     DateTime  @default(now()) @db.Timestamp(3)
  updatedAt     DateTime  @updatedAt @db.Timestamp(3)

  shipment    Shipment @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  transporter User     @relation(fields: [transporterId], references: [id], onDelete: Restrict)
  journeyPlanAssignment JourneyPlanAssignment?
  // The active-bid partial unique index is added in a SQL migration.

  @@index([shipmentId], map: "idx_bid_shipment")
  @@index([transporterId], map: "idx_bid_transporter")
}

model Message {
  id             String   @id @default(uuid()) @db.Uuid
  conversationId String?  @db.Uuid
  senderId       String   @db.Uuid
  content        String   @db.Text
  createdAt      DateTime @default(now()) @db.Timestamp(3)

  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  sender       User          @relation(fields: [senderId], references: [id], onDelete: Restrict)

  @@index([conversationId, createdAt], map: "idx_message_conversation_created")
}

model Conversation {
  id            String   @id @default(uuid()) @db.Uuid
  shipperId     String   @db.Uuid
  transporterId String   @db.Uuid
  createdAt     DateTime @default(now()) @db.Timestamp(3)
  updatedAt     DateTime @updatedAt @db.Timestamp(3)

  shipper     User      @relation("ConversationShipper", fields: [shipperId], references: [id], onDelete: Restrict)
  transporter User      @relation("ConversationTransporter", fields: [transporterId], references: [id], onDelete: Restrict)
  messages    Message[]

  @@unique([shipperId, transporterId], map: "idx_conversation_shipper_transporter")
  @@index([shipperId, updatedAt(sort: Desc)], map: "idx_conversation_shipper_updated")
  @@index([transporterId, updatedAt(sort: Desc)], map: "idx_conversation_transporter_updated")
}

model Review {
  id         String   @id @default(uuid()) @db.Uuid
  shipmentId String   @db.Uuid
  reviewerId String   @db.Uuid
  revieweeId String   @db.Uuid
  rating     Int
  comment    String?  @db.Text
  createdAt  DateTime @default(now()) @db.Timestamp(3)

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  reviewer User     @relation("ReviewReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)
  reviewee User     @relation("ReviewReviewee", fields: [revieweeId], references: [id], onDelete: Restrict)
  // The rating CHECK constraint is added in a SQL migration.

  @@unique([shipmentId, reviewerId])
  @@index([revieweeId], map: "idx_review_reviewee")
}

model Notification {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  type        String   @db.VarChar(50)
  title       String   @db.VarChar(255)
  message     String   @db.Text
  read        Boolean  @default(false)
  referenceId String?  @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamp(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt(sort: Desc)], map: "idx_notification_user")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  expiresAt DateTime @db.Timestamp(3)
  token     String   @unique @db.VarChar(255)
  ipAddress String?  @db.VarChar(255)
  userAgent String?  @db.Text
  createdAt DateTime @default(now()) @db.Timestamp(3)
  updatedAt DateTime @updatedAt @db.Timestamp(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(uuid()) @db.Uuid
  accountId             String    @db.VarChar(255)
  providerId            String    @db.VarChar(255)
  userId                String    @db.Uuid
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime? @db.Timestamp(3)
  refreshTokenExpiresAt DateTime? @db.Timestamp(3)
  scope                 String?   @db.Text
  password              String?   @db.Text
  createdAt             DateTime  @default(now()) @db.Timestamp(3)
  updatedAt             DateTime  @updatedAt @db.Timestamp(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String   @db.VarChar(255)
  value      String   @db.Text
  expiresAt  DateTime @db.Timestamp(3)
  createdAt  DateTime @default(now()) @db.Timestamp(3)
  updatedAt  DateTime @updatedAt @db.Timestamp(3)

  @@index([identifier])
}

model JourneyPlan {
  id                String            @id @default(uuid()) @db.Uuid
  transporterId     String            @db.Uuid
  originCity        String            @db.VarChar(100)
  destinationCity   String            @db.VarChar(100)
  departureDate     DateTime          @db.Date
  fullLoadPrice     Decimal           @db.Decimal(12, 2)
  status            JourneyPlanStatus @default(ACTIVE)
  maxWeightKg       Decimal           @db.Decimal(10, 2)
  maxVolumeM3       Decimal?          @db.Decimal(10, 2)
  allocatedWeightKg Decimal           @default(0) @db.Decimal(10, 2)
  allocatedVolumeM3 Decimal           @default(0) @db.Decimal(10, 2)
  createdAt         DateTime          @default(now()) @db.Timestamp(3)
  updatedAt         DateTime          @updatedAt @db.Timestamp(3)

  transporter User                    @relation(fields: [transporterId], references: [id], onDelete: Cascade)
  assignments JourneyPlanAssignment[]

  @@index([transporterId, status], map: "idx_journey_plan_transporter_status")
  @@index([departureDate], map: "idx_journey_plan_departure_date")
}

model JourneyPlanAssignment {
  id            String      @id @default(uuid()) @db.Uuid
  journeyPlanId String      @db.Uuid
  shipmentId    String      @db.Uuid
  bidId         String      @unique @db.Uuid
  weightKg      Decimal     @db.Decimal(10, 2)
  volumeM3      Decimal?    @db.Decimal(10, 2)
  assignedAt    DateTime    @default(now()) @db.Timestamp(3)

  journeyPlan JourneyPlan @relation(fields: [journeyPlanId], references: [id], onDelete: Cascade)
  shipment    Shipment    @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  bid         Bid         @relation(fields: [bidId], references: [id], onDelete: Restrict)

  @@index([journeyPlanId], map: "idx_journey_assignment_plan")
  @@index([shipmentId], map: "idx_journey_assignment_shipment")
}

